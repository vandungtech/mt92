# Copy to /etc/microtensor-miner/miner.env owned root:microtensor, mode exactly 0640.
# The controller reads it through protected_file.read_root_service_file, which refuses
# any other owner, mode, hard-link count, or a symlink.
# The wallet coldkey directory name is expected to be `you-cold`; adjust the OS path only.
MT_NETUID=92
MT_NETWORK=finney
MT_ENDPOINT=
MT_WALLET_NAME=you-cold
MT_WALLET_HOTKEY=you-hot1
MT_WALLET_PATH=/var/lib/microtensor-miner/wallets
MT_HOME=/var/lib/microtensor-miner/upstream

MMC_EXPECTED_UID=32
MMC_STATE_DIR=/var/lib/microtensor-miner/controller
MMC_ARTIFACT_DIR=/var/lib/microtensor-miner/artifact
# Required private authorization binding: exact root:microtensor owner, mode 0640, one hard link.
MMC_ARTIFACT_COMPETITION_BINDING_PATH=/etc/microtensor-miner/artifact-competition.binding.json
MMC_SELFCHECK_PATH=/var/lib/microtensor-miner/upstream/selfcheck.json
MMC_SELFCHECK_BINDING_PATH=/var/lib/microtensor-miner/upstream/selfcheck.binding.json
MMC_UPSTREAM_OBSERVER_STATUS_PATH=/var/lib/microtensor-miner/upstream-observer/status.json
MMC_UPSTREAM_OBSERVER_MAX_AGE_SECONDS=900

# Signed v0.3.0 code/mt-3g activation; do not lower or omit this audited block.
MMC_V030_ACTIVATION_BLOCK=8966795
MMC_TRACK=code
MMC_HARDWARE_CLASS=mt-3g
MMC_ENTRYPOINT=model.gguf
MMC_ARTIFACT_FORMAT=gguf
MMC_QUANTIZATION=Q4_K_M
MMC_MAX_INPUT_TOKENS=512
MMC_TOKENIZER=tokenizer.json
MMC_BASE_MODEL=Qwen/Qwen3-0.6B@c1899de289a04d12100db370d81485cdf75e47ca

# Live upload creates one immutable release per round in an existing public GitHub repo.
# Keep OWNER/REPO compact so the final on-chain commitment remains below 128 bytes.
MMC_SOURCE_TEMPLATE=https:github.com/vandungtech/mt92/releases/download/r{round}

# Required only for live HTTPS upload. The raw token file must be owned root:microtensor,
# be a single-link regular non-symlink, and have mode exactly 0640.
MMC_GITHUB_TOKEN_FILE=/etc/microtensor-miner/github.token
MMC_COORDINATOR_URL=https://coordinator.microtensor.cloud
MMC_REQUIRE_ANCHORED_COORDINATOR=true
MMC_ALLOW_CHAIN_SCHEDULE_FALLBACK=false

# Leave true for read-only validation. False is accepted only with the GitHub source,
# protected token file, valid public provenance, and an anchored open round.
MMC_DRY_RUN=true
MMC_TRANSACTION_AUTHORIZATION=netuid92-uid32-you-hot1-commitment-fee0-deposit0-v1
MMC_ALLOW_UNVERIFIED_UPSTREAM=false
MMC_POLL_SECONDS=30
MMC_RETRY_SECONDS=30
MMC_DEADLINE_MARGIN_BLOCKS=40
MMC_VERIFY_ATTEMPTS=5
MMC_VERIFY_INTERVAL_SECONDS=900
MMC_HEALTH_MAX_AGE_SECONDS=180
MMC_COORDINATOR_TIMEOUT_SECONDS=10
MMC_LOG_LEVEL=INFO

# Signed v0.3.2 has PROVENANCE_REQUIRED=False, so leave this blank. Never commit a value.
WANDB_API_KEY=

# S3/R2 source templates remain dry-run diagnostics; every non-HTTPS live upload is refused.

# MT_RESULT_WORKER is deliberately absent. Upstream 53e4df6 added it as an unpublished,
# unanchored coordinator override; ControllerConfig.from_env refuses to load while it is
# set to a non-empty value. See docs/upstream-audits/53e4df6...md and launch_todo.md.
